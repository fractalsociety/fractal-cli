{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fractalsociety.dev/schemas/fractal.master_graph_view.v1.schema.json",
  "title": "fractal.master_graph_view.v1",
  "description": "Deterministic, read-only, in-memory composition of validated fractal.catalog.v1 envelopes across the frozen fractal.repository_inventory.v1. Never persisted as canonical state and never written back to any source repository. Contains no wall-clock timestamps: identical source bytes MUST produce byte-identical canonical JSON regardless of inventory ordering. Normative composition, ordering, hashing, and diagnostic rules live in docs/project-catalog-contract.md.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "view_hash",
    "inventory_hash",
    "summary",
    "projects",
    "nodes",
    "edges",
    "diagnostics",
    "sources",
    "unavailable"
  ],
  "properties": {
    "schema": {
      "const": "fractal.master_graph_view.v1"
    },
    "view_hash": {
      "$ref": "#/$defs/hash256",
      "description": "'sha256:<64 hex>' over the canonical JSON bytes of this view with the 'view_hash' key removed (sorted keys, compact separators, UTF-8)."
    },
    "inventory_hash": {
      "$ref": "#/$defs/hash256",
      "description": "inventory_hash of the frozen fractal.repository_inventory.v1 artifact composed from."
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "projects_total",
        "available_inventory_count",
        "audited_available",
        "invalid_catalogs",
        "node_count",
        "edge_count",
        "links_resolved",
        "links_unresolved",
        "cycle_count",
        "diagnostic_counts"
      ],
      "properties": {
        "projects_total": {
          "$ref": "#/$defs/count"
        },
        "available_inventory_count": {
          "$ref": "#/$defs/count"
        },
        "audited_available": {
          "$ref": "#/$defs/count",
          "description": "Available inventory records whose catalog validated as fractal.catalog.v1."
        },
        "invalid_catalogs": {
          "$ref": "#/$defs/count"
        },
        "node_count": {
          "$ref": "#/$defs/count"
        },
        "edge_count": {
          "$ref": "#/$defs/count"
        },
        "links_resolved": {
          "$ref": "#/$defs/count"
        },
        "links_unresolved": {
          "$ref": "#/$defs/count"
        },
        "cycle_count": {
          "$ref": "#/$defs/count"
        },
        "diagnostic_counts": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "error",
            "warning",
            "info"
          ],
          "properties": {
            "error": {
              "$ref": "#/$defs/count"
            },
            "warning": {
              "$ref": "#/$defs/count"
            },
            "info": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/projectEntry"
      },
      "description": "One entry per unique existing inventory workspace. Sorted ascending by project_key."
    },
    "nodes": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/node"
      },
      "description": "Sorted ascending by id; ids unique."
    },
    "edges": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/edge"
      },
      "description": "Sorted ascending by id; ids unique. Unresolved, self, and cyclic edges are retained, never dropped or recursively expanded."
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "$ref": "#/$defs/viewDiagnostic"
      },
      "description": "Sorted by (code, project_key, edge_id, context) with null sorting before any string."
    },
    "sources": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/sourceProvenance"
      },
      "description": "Byte-level provenance for every project.fractal that was read. Sorted ascending by project_key. Deliberately excludes mtimes and timestamps."
    },
    "unavailable": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/unavailableEntry"
      },
      "description": "Inventory records whose workspace does not exist or cannot be read; explicit diagnostics instead of fabricated content. Sorted by canonical_workspace."
    }
  },
  "$defs": {
    "hash256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "projectKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}-[0-9a-f]{12}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^(project:[a-z0-9][a-z0-9-]{0,47}-[0-9a-f]{12}|(component|capability):[a-z0-9][a-z0-9-]{0,47}-[0-9a-f]{12}/[a-z0-9][a-z0-9-]{0,63})$",
      "description": "Namespaced: 'project:<project_key>', 'component:<project_key>/<component_key>', 'capability:<project_key>/<capability_key>'."
    },
    "edgeId": {
      "type": "string",
      "pattern": "^(link:[a-z0-9][a-z0-9-]{0,47}-[0-9a-f]{12}/[a-z0-9][a-z0-9-]{0,63}|dep:[a-z0-9][a-z0-9-]{0,47}-[0-9a-f]{12}/[a-z0-9][a-z0-9-]{0,63}->[a-z0-9][a-z0-9-]{0,63}(:[a-z]{1,16})?)$",
      "description": "'link:<origin project_key>/<link key>' for cross_graph_links; 'dep:<project_key>/<from_component>-><to_component>[:<kind>]' for internal dependencies."
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "implemented_unverified",
        "partial",
        "unknown"
      ]
    },
    "catalogState": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "missing",
        "unsupported_schema",
        "unavailable"
      ]
    },
    "projectEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "project_key",
        "canonical_workspace",
        "workspace_fingerprint",
        "labels",
        "registry_numbers",
        "available",
        "catalog_state",
        "graph_hash",
        "catalog_hash",
        "git",
        "status_counts"
      ],
      "properties": {
        "project_key": {
          "$ref": "#/$defs/projectKey"
        },
        "canonical_workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/"
        },
        "workspace_fingerprint": {
          "$ref": "#/$defs/hash256"
        },
        "labels": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "registry_numbers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "available": {
          "type": "boolean"
        },
        "catalog_state": {
          "$ref": "#/$defs/catalogState"
        },
        "graph_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "description": "The project's execution-graph hash exactly as stored; null when the document could not be loaded."
        },
        "catalog_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash256"
            },
            {
              "type": "null"
            }
          ]
        },
        "git": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "commit",
            "dirty",
            "unavailable_reason"
          ],
          "properties": {
            "commit": {
              "anyOf": [
                {
                  "$ref": "#/$defs/gitCommit"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dirty": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "unavailable_reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            }
          }
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "verified",
            "implemented_unverified",
            "partial",
            "unknown"
          ],
          "properties": {
            "verified": {
              "$ref": "#/$defs/count"
            },
            "implemented_unverified": {
              "$ref": "#/$defs/count"
            },
            "partial": {
              "$ref": "#/$defs/count"
            },
            "unknown": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "project_key",
        "key",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "project",
            "component",
            "capability"
          ]
        },
        "project_key": {
          "$ref": "#/$defs/projectKey"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "The un-namespaced local key (for project nodes, equal to project_key's slug-and-fingerprint form is not required; use the project_key itself)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "component_kind": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "origin_project_key",
        "from",
        "to",
        "resolution",
        "cycle_group"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/edgeId"
        },
        "type": {
          "type": "string",
          "enum": [
            "depends_on",
            "uses_component",
            "derived_from",
            "forked_from",
            "supersedes",
            "shares_component",
            "related_to",
            "internal_dependency"
          ]
        },
        "origin_project_key": {
          "$ref": "#/$defs/projectKey"
        },
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "to": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "node_id",
            "raw"
          ],
          "properties": {
            "node_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/nodeId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Resolved target node; null when resolution is 'unresolved' or 'ambiguous'."
            },
            "raw": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": true,
              "description": "The original target specifier from the source catalog, preserved verbatim for unresolved/ambiguous edges; null for resolved edges."
            }
          }
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous",
            "self"
          ]
        },
        "cycle_group": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Index into the deterministic cycle numbering when this edge participates in a cross-project cycle; null otherwise."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "viewDiagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "severity",
        "message",
        "project_key",
        "edge_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ambiguous_alias",
            "catalog_bound_exceeded",
            "component_key_collision",
            "cross_project_cycle",
            "duplicate_alias",
            "duplicate_link_key",
            "invalid_catalog",
            "invalid_project_document",
            "missing_catalog",
            "missing_project_fractal",
            "project_key_collision",
            "self_link",
            "unavailable_workspace",
            "unresolved_link_component",
            "unresolved_link_target",
            "unsupported_catalog_schema",
            "view_truncated"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "project_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "edge_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/edgeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "project_key",
        "canonical_workspace",
        "relative_path",
        "project_fractal_sha256",
        "size_bytes",
        "graph_hash",
        "catalog_hash"
      ],
      "properties": {
        "project_key": {
          "$ref": "#/$defs/projectKey"
        },
        "canonical_workspace": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 1024
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^/\\\\~]"
        },
        "project_fractal_sha256": {
          "$ref": "#/$defs/hash256",
          "description": "SHA-256 of the exact on-disk bytes read; re-hashing after composition MUST match (read-only proof)."
        },
        "size_bytes": {
          "$ref": "#/$defs/count"
        },
        "graph_hash": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "catalog_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "unavailableEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "canonical_workspace",
        "reason",
        "registry_numbers"
      ],
      "properties": {
        "canonical_workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "registry_numbers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
