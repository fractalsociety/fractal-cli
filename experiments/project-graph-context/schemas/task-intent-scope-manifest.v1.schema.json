{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fractalmaster.invalid/project-graph-context/task-intent-scope-manifest.v1.schema.json",
  "title": "Task intent and scope manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "pair_id", "title", "goal", "allowed_paths", "forbidden_paths", "acceptance_checks", "dependencies"],
  "properties": {
    "schema_version": {"const": "project-graph-context.task-intent-scope-manifest.v1"},
    "task_id": {"type": "string"},
    "pair_id": {"type": "string"},
    "title": {"type": "string"},
    "goal": {"type": "string"},
    "allowed_paths": {"type": "array", "items": {"type": "string", "pattern": "^[^/]?[^\\0]*$"}},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "acceptance_checks": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "intent_weights": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
  }
}
