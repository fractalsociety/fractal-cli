        "id": "add_cross_boundary_rust_tests",
        "instruction": "Extend the existing #[cfg(test)] suites in src/compile.rs, src/execute.rs, src/amendments.rs, src/harness_evolution.rs, src/project_sync.rs, and src/graph_store.rs with end-to-end fixtures that compile a graph, persist it, execute success/failure/retry/verification/artifact-consumption/human-intervention paths, apply graph edits, serialize/reload it, and inspect the sync payload. Assert every AC-1 through AC-8 field and invariant, including exact controlled values, legacy migration, round-trip preservation, compact reference-only evidence, and graph hash validity. Keep tests deterministic with injected/fixed timestamps and no live network, model, agent, or cloud dependency. Do not edit src/learning_data.rs, src/project_file.rs, Swift files, production behavior, or dist-* paths.",
        "kind": "container",
        "memory_scopes": [
          "work:goal",
          "workspace:root"
